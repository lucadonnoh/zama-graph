{
  "name": "zama-graph",
  "version": "0.1.0",
  "private": true,
  "description": "Indexes Zama confidential tokens and shows what their public data reveals: every link, and most amounts.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "dev:all": "concurrently -k -n sync,serve,web -c blue,green,magenta \"pnpm sync --follow\" \"pnpm serve\" \"pnpm web\"",
    "sync": "tsx src/cli.ts sync",
    "serve": "tsx src/cli.ts serve",
    "web": "vite",
    "build": "pnpm build:web && tsc -p tsconfig.json",
    "build:web": "vite build",
    "start": "NODE_ENV=production concurrently -k -n sync,serve -c blue,green \"node dist/cli.js sync --follow\" \"node dist/cli.js serve\"",
    "start:serve": "NODE_ENV=production node dist/cli.js serve",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "mocha",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0",
    "concurrently": "^10.0.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/express": "^5.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "earl": "^1.3.0",
    "mocha": "^10.8.2",
    "postcss": "^8.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
