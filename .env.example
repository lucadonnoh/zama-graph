# Ethereum JSON-RPC: logs of the wrappers, the FHEVMExecutor and the ACL
ETHEREUM_RPC_URL=
# Zama Gateway (chain 261131): public decryptions and user decryption requests
ZAMA_RPC_URL=https://rpc.mainnet.zama.org
# SQLite file
ZAMA_GRAPH_DB=data/zama-graph.sqlite
PORT=3021
# Address the API listens on; keep it local when a tunnel fronts it
HOST=127.0.0.1
# Browser origin allowed to call the API, e.g. the Pages site (or *)
CORS_ORIGIN=
# Contract names of counterparties (optional, labels hubs by verified name)
ETHERSCAN_API_KEY=
# Zama's hosted relayer, for `pnpm dev decrypt` (optional, from Zama's form)
ZAMA_RELAYER_API_KEY=
